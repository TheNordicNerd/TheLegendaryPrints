<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#2C4FA3">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/x-icon" href="{{ 'favicon.ico' | asset_url }}">
      <link rel="icon" type="image/png" sizes="96x96" href="{{ 'favicon-96x96.png' | asset_url }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">
    {%- endif -%}

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- Google Fonts: Montserrat & Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {% style %}
      :root {
        /* Brand Colors */
        --color-magenta: #FF006E;
        --color-yellow: #FED801;
        --color-cyan: #00a8c6;
        --color-black: #000000;
        --color-white: #FFFFFF;

        /* Primary & Secondary */
        --color-primary: var(--color-magenta);
        --color-secondary: var(--color-cyan);

        /* Neutral Scale */
        --color-neutral-50: #FAFAFA;
        --color-neutral-100: #F5F5F5;
        --color-neutral-200: #E5E5E5;
        --color-neutral-300: #D4D4D4;
        --color-neutral-400: #A3A3A3;
        --color-neutral-500: #737373;
        --color-neutral-600: #525252;
        --color-neutral-700: #404040;
        --color-neutral-800: #262626;
        --color-neutral-900: #171717;

        /* Semantic Colors */
        --color-success: #22C55E;
        --color-error: #EF4444;
        --color-warning: #F59E0B;

        /* Surface Colors */
        --color-surface-base: #FFFFFF;
        --color-surface-raised: #FFFFFF;
        --color-surface-overlay: #FFFFFF;
        --color-surface-sunken: #F5F5F5;

        /* Text Colors */
        --color-text-primary: #171717;
        --color-text-secondary: #525252;
        --color-text-tertiary: #737373;
        --color-text-disabled: #A3A3A3;
        --color-text-inverse: #FFFFFF;
        --color-text-link: #FF006E;
        --color-text-link-hover: #D4005A;

        /* Border Colors */
        --color-border-subtle: #E5E5E5;
        --color-border-default: #D4D4D4;
        --color-border-emphasis: #A3A3A3;
        --color-border-focus: #FF006E;

        /* Fonts */
        --font-heading: 'Montserrat', sans-serif;
        --font-body: 'Inter', sans-serif;
        --font-accent: 'Quirthy', cursive;
      }

      body {
        font-family: var(--font-body);
        background-color: var(--color-surface-base);
        color: var(--color-text-primary);
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-heading);
      }
    {% endstyle %}

    {{ 'app.css' | asset_url | stylesheet_tag }}
    {{ 'fonts.css' | asset_url | stylesheet_tag }}
    {{ 'custom.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="bg-surface-base antialiased">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };

      window.cartStrings = {
        error: `{{ 'sections.cart.cart_error' | t }}`,
        quantityError: `{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`
      }

      window.variantStrings = {
        addToCart: `{{ 'products.product.add_to_cart' | t }}`,
        soldOut: `{{ 'products.product.sold_out' | t }}`,
        unavailable: `{{ 'products.product.unavailable' | t }}`,
      }
    </script>
  </body>
</html>
