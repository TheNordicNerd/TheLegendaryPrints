{% comment %}
  Cart Template
  Shopping cart page
{% endcomment %}

<div class="cart-page max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <h1 class="text-3xl md:text-4xl font-bold text-text-primary mb-8">Shopping Cart</h1>

  {% if cart.item_count > 0 %}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Cart Items -->
      <div class="lg:col-span-2">
        <div class="bg-surface-raised rounded-lg shadow-md p-6">
          <form action="{{ routes.cart_url }}" method="post" id="cart-form">
            <div class="space-y-6">
              {% for item in cart.items %}
                <div class="cart-item flex gap-4 pb-6 border-b border-border-subtle last:border-b-0">
                  <!-- Product Image -->
                  <div class="flex-shrink-0">
                    <a href="{{ item.url }}" class="block w-24 h-24 rounded-lg overflow-hidden">
                      {% if item.image %}
                        <img
                          src="{{ item.image | image_url: width: 200 }}"
                          alt="{{ item.image.alt | escape }}"
                          class="w-full h-full object-cover"
                          loading="lazy"
                        >
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover' }}
                      {% endif %}
                    </a>
                  </div>

                  <!-- Product Info -->
                  <div class="flex-1 min-w-0">
                    <h3 class="font-semibold text-text-primary mb-1">
                      <a href="{{ item.url }}" class="hover:text-magenta transition-colors">
                        {{ item.product.title }}
                      </a>
                    </h3>

                    <!-- Variant Info -->
                    {% unless item.variant.title == 'Default Title' %}
                      <p class="text-sm text-text-secondary mb-2">
                        {{ item.variant.title }}
                      </p>
                    {% endunless %}

                    <!-- Price -->
                    <p class="text-lg font-bold text-text-primary mb-3">
                      {{ item.final_line_price | money }}
                    </p>

                    <!-- Quantity Controls -->
                    <div class="flex items-center gap-4">
                      <div class="flex items-center gap-2">
                        <button
                          type="button"
                          class="qty-btn px-3 py-1 bg-neutral-100 rounded hover:bg-neutral-200 transition-colors"
                          onclick="updateQuantity({{ forloop.index }}, {{ item.quantity | minus: 1 }})"
                        >
                          -
                        </button>
                        <input
                          type="number"
                          name="updates[]"
                          id="updates_{{ forloop.index }}"
                          value="{{ item.quantity }}"
                          min="0"
                          class="w-16 text-center px-2 py-1 border-2 border-neutral-300 rounded"
                          onchange="this.form.submit()"
                        >
                        <button
                          type="button"
                          class="qty-btn px-3 py-1 bg-neutral-100 rounded hover:bg-neutral-200 transition-colors"
                          onclick="updateQuantity({{ forloop.index }}, {{ item.quantity | plus: 1 }})"
                        >
                          +
                        </button>
                      </div>

                      <!-- Remove Button -->
                      <button
                        type="button"
                        class="text-sm text-error hover:underline"
                        onclick="updateQuantity({{ forloop.index }}, 0)"
                      >
                        Remove
                      </button>
                    </div>
                  </div>

                  <!-- Item Total (Desktop) -->
                  <div class="hidden md:block text-right">
                    <p class="text-lg font-bold text-text-primary">
                      {{ item.final_line_price | money }}
                    </p>
                    <p class="text-sm text-text-secondary">
                      {{ item.final_price | money }} each
                    </p>
                  </div>
                </div>
              {% endfor %}
            </div>
          </form>

          <!-- Continue Shopping -->
          <div class="mt-6">
            <a href="/collections/all" class="inline-flex items-center gap-2 text-magenta font-semibold hover:underline">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
              </svg>
              Continue Shopping
            </a>
          </div>
        </div>
      </div>

      <!-- Order Summary -->
      <div class="lg:col-span-1">
        <div class="bg-surface-raised rounded-lg shadow-md p-6 sticky top-4">
          <h2 class="text-xl font-bold text-text-primary mb-6">Order Summary</h2>

          <div class="space-y-4 mb-6">
            <div class="flex justify-between text-text-secondary">
              <span>Subtotal ({{ cart.item_count }} items)</span>
              <span class="font-semibold">{{ cart.total_price | money }}</span>
            </div>

            {% if cart.total_discount > 0 %}
              <div class="flex justify-between text-success">
                <span>Discount</span>
                <span class="font-semibold">-{{ cart.total_discount | money }}</span>
              </div>
            {% endif %}

            <div class="border-t border-border-subtle pt-4">
              <div class="flex justify-between text-lg font-bold text-text-primary">
                <span>Total</span>
                <span>{{ cart.total_price | money }}</span>
              </div>
              <p class="text-xs text-text-secondary mt-1">
                Shipping & taxes calculated at checkout
              </p>
            </div>
          </div>

          <!-- Checkout Button -->
          <button
            type="submit"
            name="checkout"
            class="w-full px-6 py-4 bg-magenta text-white text-lg font-semibold rounded-lg hover:opacity-90 transition-opacity mb-4"
            onclick="window.location.href='/checkout'"
          >
            Proceed to Checkout
          </button>

          <!-- Payment Icons -->
          <div class="flex justify-center gap-2 text-xs text-text-secondary">
            <span>Secure Checkout</span>
          </div>
        </div>
      </div>
    </div>
  {% else %}
    <!-- Empty Cart -->
    <div class="text-center py-12">
      <svg class="w-32 h-32 mx-auto text-neutral-300 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
      </svg>
      <h2 class="text-3xl font-bold text-text-primary mb-4">Your cart is empty</h2>
      <p class="text-text-secondary mb-8">Add some products to get started!</p>
      <a href="/collections/all" class="inline-block px-6 py-3 bg-magenta text-white rounded-lg font-semibold hover:opacity-90 transition-opacity">
        Start Shopping
      </a>
    </div>
  {% endif %}
</div>

<script>
  function updateQuantity(line, quantity) {
    const input = document.getElementById(`updates_${line}`);
    input.value = quantity;
    document.getElementById('cart-form').submit();
  }
</script>
