{% comment %}
  Marquee Section
  Scrolling banner with icons and text
  Converted from Marquee.vue component
{% endcomment %}

<div class="marquee-container bg-neutral-900 w-full overflow-hidden">
  <div class="marquee-track border-t-2 border-neutral-800 py-4">
    <!-- First set of items -->
    <div class="marquee-content">
      {% for block in section.blocks %}
        <div class="marquee-item">
          {% if block.settings.icon_svg != blank %}
            <div class="text-yellow">
              {{ block.settings.icon_svg }}
            </div>
          {% endif %}
          <h2 class="text-neutral-50 text-2xl font-medium whitespace-nowrap">
            {{ block.settings.text }}
          </h2>
        </div>
      {% endfor %}
    </div>

    <!-- Duplicate set for seamless loop -->
    <div class="marquee-content" aria-hidden="true">
      {% for block in section.blocks %}
        <div class="marquee-item">
          {% if block.settings.icon_svg != blank %}
            <div class="text-yellow">
              {{ block.settings.icon_svg }}
            </div>
          {% endif %}
          <h2 class="text-neutral-50 text-2xl font-medium whitespace-nowrap">
            {{ block.settings.text }}
          </h2>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .marquee-container {
    overflow: hidden;
    width: 100%;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: scrolling 30s linear infinite;
  }

  .marquee-content {
    display: flex;
    gap: 4rem;
    flex-shrink: 0;
    padding-left: 4rem;
  }

  .marquee-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 2rem;
  }

  .marquee-item svg {
    width: 36px;
    height: 36px;
  }

  @keyframes scrolling {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }
  }
</style>

