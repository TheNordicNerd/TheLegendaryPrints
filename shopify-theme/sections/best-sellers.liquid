{% comment %}
  Best Sellers Section
  Converted from BestSellers.vue component
  Displays products from a specific collection
{% endcomment %}

<section class="best-sellers py-12 md:py-24 bg-surface-sunken px-8 lg:px-0">
  <div class="max-w-7xl mx-auto text-center">
    <div class="mb-12">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary mb-4">
        {{ section.settings.title }}
      </h2>
      <p class="text-lg md:text-xl text-text-secondary max-w-2xl mx-auto mb-6">
        {{ section.settings.description }}
      </p>
      {% if section.settings.show_view_all %}
        <a href="/collections/all" class="hover:scale-105 duration-300 inline-flex items-center gap-2 text-magenta font-semibold">
          View All
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      {% endif %}
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 px-4 sm:px-0">
      {% if section.settings.collection != blank %}
        {% assign products = section.settings.collection.products | limit: section.settings.products_to_show %}
        {% for product in products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% comment %} Show placeholder if no collection selected {% endcomment %}
        {% for i in (1..4) %}
          <div class="bg-surface-base rounded-lg shadow-md p-4 animate-pulse">
            <div class="bg-neutral-200 h-48 rounded-lg mb-4"></div>
            <div class="bg-neutral-200 h-4 rounded mb-2"></div>
            <div class="bg-neutral-200 h-4 rounded w-3/4"></div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Best Sellers",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Check Out Our Best Sellers"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Choose from some of the top products others are looking at."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Number of products to show",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Best Sellers"
    }
  ]
}
{% endschema %}
