{% comment %}
  Footer Section - Matches Nuxt Footer.vue
{% endcomment %}

<footer class="relative bg-black px-4">
  <!-- Main Footer Content -->
  <div class="py-12 pt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Links and Social -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 pb-12">
        <!-- Logo - Hidden on mobile, visible on lg -->
        <div class="hidden lg:inline">
          {% if section.settings.logo != blank %}
            <img src="{{ section.settings.logo | image_url: width: 192 }}" alt="{{ shop.name }}" class="w-48" loading="lazy">
          {% else %}
            <img src="{{ 'lp-logo-bw.png' | asset_url }}" alt="{{ shop.name }}" class="w-48" loading="lazy">
          {% endif %}
        </div>

        <!-- Column 1: Shop & Legal -->
        <div class="flex items-start justify-between lg:inline">
          <div class="w-full lg:w-1/2">
            <!-- Shop Section -->
            <div>
              <h3 class="text-sm font-bold text-text-inverse uppercase tracking-wide mb-4">
                Shop
              </h3>
              <ul class="space-y-3">
                <li class="flex items-start gap-2">
                  <a href="/collections/all" class="text-text-disabled hover:text-text-tertiary transition-colors duration-200">
                    Products
                  </a>
                </li>
                <li class="flex items-start gap-2">
                  <a href="/collections/best-sellers" class="text-text-disabled hover:text-text-tertiary transition-colors duration-200">
                    Best Sellers
                  </a>
                </li>
                <li class="flex items-start gap-2">
                  <a href="/products/sample-pack" class="text-text-disabled hover:text-text-tertiary transition-colors duration-200">
                    Samples
                  </a>
                </li>
                <li class="flex items-start gap-2">
                  <a href="/pages/contact" class="text-text-disabled hover:text-text-tertiary transition-colors duration-200">
                    Business Orders
                  </a>
                </li>
              </ul>
            </div>

            <!-- Legal Section -->
            <div class="lg:mt-8 mt-6">
              <h3 class="text-sm font-bold text-text-inverse uppercase tracking-wide mb-4">
                Legal
              </h3>
              <ul class="space-y-3">
                <li class="flex items-start gap-2">
                  <a href="/pages/privacy-policy" class="text-text-disabled hover:text-text-tertiary transition-colors duration-200">
                    Privacy Policy
                  </a>
                </li>
                <li class="flex items-start gap-2">
                  <a href="/pages/refund-policy" class="text-text-disabled hover:text-text-tertiary transition-colors duration-200">
                    Refund Policy
                  </a>
                </li>
                <li class="flex items-start gap-2">
                  <a href="/pages/terms-of-service" class="text-text-disabled hover:text-text-tertiary transition-colors duration-200">
                    Terms Of Service
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Column 2: Connect -->
        <div class="flex items-start justify-between lg:inline">
          <div class="w-full lg:w-1/2">
            <div>
              <h3 class="text-sm font-bold text-text-inverse uppercase tracking-wide mb-4">
                Connect
              </h3>
              <ul class="space-y-3">
                <li class="flex items-start gap-2">
                  <!-- Mail Icon -->
                  <svg class="w-5 h-5 text-text-disabled flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                  <a href="mailto:hello@thelegendaryprints.com" class="text-text-disabled hover:text-text-tertiary transition-colors duration-200">
                    hello@thelegendaryprints.com
                  </a>
                </li>
                <li class="flex items-start gap-2">
                  <!-- Phone Icon -->
                  <svg class="w-5 h-5 text-text-disabled flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                  </svg>
                  <a href="tel:+14074764413" class="text-text-disabled hover:text-text-tertiary transition-colors duration-200">
                    (407) 476-4413
                  </a>
                </li>
                <li class="flex items-start gap-2">
                  <!-- Store Icon -->
                  <svg class="w-5 h-5 text-text-disabled flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                  </svg>
                  <a href="https://maps.google.com/?q=40+N+Charles+Richard+Beall+Blvd,+DeBary,+FL+32713" target="_blank" rel="noopener noreferrer" class="text-text-disabled hover:text-text-tertiary transition-colors duration-200">
                    40 N Charles Richard Beall Blvd, DeBary, FL 32713
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Bottom Bar -->
      <div class="pt-8 border-t border-border-subtle">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          <!-- Copyright -->
          <div class="flex flex-col items-center md:items-start gap-1">
            <p class="text-xs text-text-disabled text-center md:text-left">
              © {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
            </p>
            <a
              href="https://thenordicnerd.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[10px] text-text-disabled hover:text-text-tertiary transition-colors duration-200 text-center md:text-left"
            >
              Forged by The Nordic Nerd
            </a>
          </div>

          <!-- Social Media Icons -->
          <div class="flex justify-end gap-6">
            <!-- TikTok -->
            <a
              href="https://www.tiktok.com/@thelegendaryprints"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="TikTok"
              class="text-text-disabled hover:text-text-tertiary transition-colors duration-200"
            >
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/>
              </svg>
            </a>
            <!-- Facebook -->
            <a
              href="https://www.facebook.com/thelegendaryprints"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="text-text-disabled hover:text-text-tertiary transition-colors duration-200"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"></path>
              </svg>
            </a>
            <!-- Instagram -->
            <a
              href="https://www.instagram.com/thelegendaryprints"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="text-text-disabled hover:text-text-tertiary transition-colors duration-200"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37zm1.5-4.87h.01"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.8 21h12.4c1.1 0 2.1-.4 2.8-1.2.8-.8 1.2-1.8 1.2-2.8V7c0-1-.4-2-1.2-2.8-.7-.8-1.7-1.2-2.8-1.2H5.8c-1.1 0-2.1.4-2.8 1.2C2.2 5 1.8 6 1.8 7v10c0 1 .4 2 1.2 2.8.7.8 1.7 1.2 2.8 1.2z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    footer a,
    footer button {
      transition-duration: 0.01ms !important;
    }
  }
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo (Black & White version recommended)"
    }
  ]
}
{% endschema %}
