{% comment %}
  Process Steps Section
  "How It Works" with numbered steps
  Converted from ProcessSection.vue component
{% endcomment %}

<section class="process-section py-12 md:py-20 bg-surface-base">
  <div class="max-w-6xl mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary mb-4">
        {{ section.settings.title }}
      </h2>
      <p class="text-lg md:text-xl text-text-secondary max-w-2xl mx-auto">
        {{ section.settings.description }}
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      <!-- Connector Lines (hidden on mobile) -->
      <div class="hidden md:block absolute  left-0 right-0 h-0.5 bg-neutral-200" style="top: 2rem;"></div>

      {% for block in section.blocks %}
        <div class="relative flex flex-col items-center process-step">
          <!-- Step Number Circle -->
          <div class="w-16 h-16 rounded-full bg-magenta text-white flex items-center justify-center text-2xl font-bold mb-4 relative z-10 shadow-lg">
            {{ forloop.index }}
          </div>

          <!-- Icon -->
          <div class="p-3 bg-neutral-100 rounded-lg grid place-items-center w-fit mb-4">
            {% if block.settings.icon_svg != blank %}
              <div class="text-magenta">
                {{ block.settings.icon_svg }}
              </div>
            {% endif %}
          </div>

          <!-- Title -->
          <h3 class="text-xl text-center font-bold text-text-primary mb-2">
            {{ block.settings.title }}
          </h3>

          <!-- Description -->
          <p class="text-text-secondary text-center">
            {{ block.settings.description }}
          </p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .process-step {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .process-step:hover {
    transform: translateY(-4px);
  }

  .process-step svg {
    width: 32px;
    height: 32px;
  }

  @media (prefers-reduced-motion: reduce) {
    .process-step {
      transition-duration: 0.01ms !important;
    }

    .process-step:hover {
      transform: none !important;
    }
  }
</style>

