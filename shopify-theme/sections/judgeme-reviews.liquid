{% comment %}
  Judge.me Reviews Section
  Shows Judge.me review carousel on homepage
  NOTE: Requires Judge.me app to be installed
{% endcomment %}

<section class="judgeme-reviews-section py-12 md:py-24 bg-surface-sunken">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary mb-4">
        {{ section.settings.title }}
      </h2>
      {% if section.settings.description != blank %}
        <p class="text-lg md:text-xl text-text-secondary max-w-2xl mx-auto">
          {{ section.settings.description }}
        </p>
      {% endif %}
    </div>

    {% if shop.metafields.judgeme.badge != blank %}
      <!-- Judge.me Reviews Widget (Installed) -->
      <div class="judgeme-widget-wrapper">
        {% comment %}
          Judge.me Carousel Widget
          This will automatically populate with your actual reviews
        {% endcomment %}
        <div class='jdgm-carousel-wrapper' data-carousel-id='all'>
          {{ shop.metafields.judgeme.badge }}
        </div>

        {% comment %}
          Alternative: All Reviews Widget
          Uncomment this if you want to show all reviews instead of a carousel
        {% endcomment %}
        {% comment %}
        <div class='jdgm-all-reviews-widget' data-product-title='{{ product.title }}'>
          {{ product.metafields.judgeme.widget }}
        </div>
        {% endcomment %}
      </div>
    {% else %}
      <!-- Fallback message - Judge.me not installed -->
      <div class="text-center mt-8 bg-surface-raised border-2 border-dashed border-neutral-300 rounded-lg p-12">
        <svg class="w-16 h-16 mx-auto mb-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
        </svg>
        <h3 class="text-xl font-bold text-text-primary mb-3">
          Customer Reviews Coming Soon
        </h3>
        <p class="text-text-secondary mb-4">
          Install <a href="https://apps.shopify.com/judgeme" target="_blank" class="text-magenta font-semibold hover:underline">Judge.me</a> to display verified customer reviews with photos and ratings
        </p>
        <a
          href="https://apps.shopify.com/judgeme"
          target="_blank"
          class="inline-flex items-center gap-2 px-6 py-3 bg-magenta text-white rounded-lg font-semibold hover:opacity-90 transition-opacity"
        >
          Install Judge.me
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  /* Custom styling for Judge.me widgets to match brand */
  .jdgm-carousel-wrapper {
    min-height: 200px;
  }

  /* Override Judge.me colors to match brand */
  .jdgm-star.jdgm--on {
    color: var(--color-magenta) !important;
  }

  .jdgm-rev-widg__actions button {
    background-color: var(--color-magenta) !important;
  }

  .jdgm-rev-widg__actions button:hover {
    opacity: 0.9 !important;
  }
</style>

{% schema %}
{
  "name": "Judge.me Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "See What Our Customers Say"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Section Description",
      "default": "Real reviews from real customers"
    }
  ],
  "presets": [
    {
      "name": "Judge.me Reviews"
    }
  ]
}
{% endschema %}
